<!-- Created with Jaspersoft Studio version 7.0.3.final using JasperReports Library version 7.0.3-41034ca841d452f3305ba55b9042260aaa1ab5dd  -->
<jasperReport name="SalesReport" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="07e74480-9a85-4de8-a632-52c9a6dea317">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="FECHAI" class="java.sql.Date"/>
	<parameter name="FECHAF" class="java.sql.Date"/>
	<query language="sql"><![CDATA[SELECT 
    gp.NOMBRE AS GRUPO_PRODUCTO,
    p.NOMBRE AS PRODUCTO,
    SUM(df.CANTIDAD) AS CANTIDAD_VENDIDA
FROM DETALLE_FACTURA df,
     FACTURA f,
     PRODUCTO p,
     GRUPO_PRODUCTO gp
WHERE df.ID_FACTURA = f.ID_FACTURA
  AND df.ID_PRODUCTO = p.ID_PRODUCTO
  AND p.ID_GRUPO_PRODUCTO = gp.ID_GRUPO_PRODUCTO
  AND f.FECHA_FACTURA BETWEEN $P{FECHAI} AND $P{FECHAF}
  AND f.ESTADO = 'ACTIVA'
GROUP BY gp.NOMBRE, p.NOMBRE
ORDER BY GRUPO_PRODUCTO, CANTIDAD_VENDIDA DESC]]></query>
	<field name="PRODUCTO" class="java.lang.String"/>
	<field name="CANTIDAD_VENDIDA" class="java.lang.Long"/>
	<field name="GRUPO_PRODUCTO" class="java.lang.String"/>
