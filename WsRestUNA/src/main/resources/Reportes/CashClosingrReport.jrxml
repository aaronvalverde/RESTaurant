<jasperReport name="CashClosingrReport" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="3f096f10-59b4-4c86-a9f4-5fdf7e7715c8">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="CAJERO" class="java.lang.Long"/>
	<parameter name="FECHAI" class="java.sql.Date"/>
	<parameter name="DINEROI" class="java.lang.Long"/>
	<query language="sql"><![CDATA[SELECT 
    cc.ID_USUARIO_CAJERO AS CAJERO,
    TRUNC(cc.FECHA_APERTURA) AS FECHAI,
    cc.EFECTIVO_INICIAL AS DINEROI,
    NVL(cc.TARJETA_SISTEMA, 0) AS CARD,
    NVL(cc.EFECTIVO_SISTEMA, 0) AS CASH,
    NVL(cc.PAYPAL_SISTEMA, 0) AS PAYPAL,
    NVL(cc.TARJETA_SISTEMA, 0) + NVL(cc.EFECTIVO_SISTEMA, 0) + NVL(cc.PAYPAL_SISTEMA, 0) AS TOTAL,
    GREATEST(cc.EFECTIVO_DECLARADO - cc.EFECTIVO_SISTEMA, 0) AS SOBRA,
    GREATEST(cc.EFECTIVO_SISTEMA - cc.EFECTIVO_DECLARADO, 0) AS FALT,
    cc.TOTAL_FACTURAS AS TFACTURA,
    0 AS TIP
FROM CIERRE_CAJA cc
WHERE cc.ID_CIERRE_CAJA = $P{CAJERO}
AND cc.ESTADO = 'CERRADO']]></query>
	<field name="CAJERO" class="java.lang.Long"/>
	<field name="FECHAI" class="java.sql.Date"/>
	<field name="DINEROI" class="java.lang.Long"/>
	<field name="CARD" class="java.lang.Long"/>
	<field name="CASH" class="java.lang.Long"/>
	<field name="PAYPAL" class="java.lang.Long"/>
	<field name="TIP" class="java.lang.Long"/>
	<field name="TOTAL" class="java.lang.Long"/>
	<field name="SOBRA" class="java.lang.Long"/>
	<field name="FALT" class="java.lang.Long"/>
	<field name="TFACTURA" class="java.lang.Integer"/>
