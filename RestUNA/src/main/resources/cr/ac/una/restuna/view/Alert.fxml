<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="200.0" prefWidth="550.0" styleClass="mainFxmlClass" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/24.0.1" fx:controller="cr.ac.una.restuna.controller.AlertController">
    <stylesheets>
        <URL value="@/cr/ac/una/restuna/view/Styles.css" />
    </stylesheets>
   <children>
      <VBox layoutX="143.0" layoutY="-52.0" prefHeight="200.0" prefWidth="100.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER_RIGHT" prefHeight="28.0" prefWidth="480.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="lbAlertTitle" text="Label" />
                     </children>
                  </HBox>
                  <MFXButton fx:id="btnClose" contentDisplay="GRAPHIC_ONLY" onAction="#onActionBtnClose" text="Button">
                     <graphic>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true" />
                     </graphic>
                  </MFXButton>
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
               <children>
                  <ImageView fx:id="imvAlertGraphic" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" />
                  <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="lbAlertInfo" text="Label" />
                        <Label fx:id="lbAlertDescription" text="Label" />
                        <HBox alignment="BOTTOM_RIGHT" prefHeight="119.0" prefWidth="380.0">
                           <children>
                              <MFXButton fx:id="btnYes" onAction="#onActionBtnYes" />
                              <MFXButton fx:id="btnNo" onAction="#onActionBtnNo" />
                              <MFXButton fx:id="btnOk" onAction="#onActionBtnOk" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
