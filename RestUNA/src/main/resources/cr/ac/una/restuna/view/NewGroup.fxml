<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXCheckbox?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="600.0" prefWidth="450.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.restuna.controller.NewGroupController">
    <stylesheets>
        <URL value="@Styles.css" />
    </stylesheets>
    <children>
        <VBox layoutX="144.0" layoutY="111.0" prefHeight="200.0" prefWidth="100.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label text="%lb.new.menu.group">
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </Label>
                <VBox prefHeight="150.0" prefWidth="100.0" spacing="10.0">
                    <children>
                        <Label text="%lb.name" />
                        <MFXTextField fx:id="txfName" floatMode="DISABLED" maxWidth="1.7976931348623157E308">
                            <cursor>
                                <Cursor fx:constant="TEXT" />
                            </cursor>
                        </MFXTextField>
                    </children>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </VBox>
                <VBox prefHeight="150.0" prefWidth="100.0" spacing="10.0">
                    <children>
                        <Label text="%lb.description" />
                  <TextArea fx:id="txaDescription" prefHeight="200.0" prefWidth="200.0" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </VBox>
            <VBox prefHeight="113.0" prefWidth="410.0" spacing="10.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                     <children>
                        <MFXCheckbox fx:id="cbShortcut" text="%cb.shortcut" />
                     </children>
                  </HBox>
                  <HBox prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <Label text="%lb.shortcut.group" />
                     </children>
                  </HBox>
               </children>
               <VBox.margin>
                  <Insets bottom="20.0" />
               </VBox.margin>
            </VBox>
            <VBox alignment="BOTTOM_LEFT" prefHeight="83.0" prefWidth="410.0">
               <children>
                  <MFXCheckbox fx:id="cbStatus" text="%cb.status" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
                <HBox alignment="CENTER_RIGHT" prefHeight="153.0" prefWidth="460.0" spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                  <MFXButton fx:id="btnSaveChanges" onAction="#onActionBtnSaveChanges" text="%btn.save.changes" />
                        <MFXButton fx:id="btnAdd" onAction="#onActionBtnAdd" text="%btn.add">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </MFXButton>
                        <MFXButton fx:id="btnCancel" onAction="#onActionBtnCancel" text="%btn.cancel">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </MFXButton>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>
