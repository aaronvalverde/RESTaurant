<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXTreeTableView?>
<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXFilterComboBox?>
<?import io.github.palexdev.materialfx.controls.MFXScrollPane?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TreeTableColumn?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="800.0" prefWidth="1280.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.restuna.controller.ItemsMgmtController">
    <stylesheets>
        <URL value="@Styles.css" />
    </stylesheets>
    <children>
        <VBox layoutX="455.0" layoutY="278.0" prefHeight="200.0" prefWidth="100.0" styleClass="jfx-main-background" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox prefHeight="100.0" prefWidth="200.0">
                    <children>
                        <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="jfx-titles" text="%lb.itemsmgmt" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                    <children>
                        <MFXTextField fx:id="txfSearch" floatMode="DISABLED" prefWidth="463.0" promptText="%txf.search.items" HBox.hgrow="ALWAYS">
                            <cursor>
                                <Cursor fx:constant="TEXT" />
                            </cursor>
                        </MFXTextField>
                        <MFXFilterComboBox fx:id="cmbGroups" floatMode="DISABLED" promptText="%cmb.group">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </MFXFilterComboBox>
                        <MFXFilterComboBox fx:id="cmbStatus" floatMode="DISABLED" promptText="%cmb.status">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </MFXFilterComboBox>
                        <MFXButton fx:id="btnClearFilters" contentDisplay="GRAPHIC_ONLY" minHeight="50.0" onAction="#onActionBtnClearFilters" text="%btn.clear.filters">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                     <graphic>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true" />
                     </graphic>
                        </MFXButton>
                        <HBox prefHeight="100.0" prefWidth="312.0" HBox.hgrow="ALWAYS" />
                        <MFXButton fx:id="btnAdd" contentDisplay="RIGHT" minHeight="50.0" onAction="#onActionBtnAdd" text="%btn.add.item">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                     <graphic>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true" />
                     </graphic>
                        </MFXButton>
                    </children>
                </HBox>
                <MFXScrollPane fx:id="tableRoot" hbarPolicy="NEVER" style="-fx-background-color: transparent;" styleClass="jfx-no-fill-container" vbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                    <content>
                        <JFXTreeTableView fx:id="tbvMenuItems">
                            <columns>
                                <TreeTableColumn fx:id="tbcID" prefWidth="75.0" text="%tbc.id" />
                                <TreeTableColumn fx:id="tbcName" prefWidth="75.0" text="%tbc.name" />
                                <TreeTableColumn fx:id="tbcShortcut" prefWidth="75.0" text="%tbc.group" />
                                <TreeTableColumn fx:id="tbcPrice" prefWidth="75.0" text="%tbc.price" />
                                <TreeTableColumn fx:id="tbcShortcut" prefWidth="75.0" text="%tbc.shortcut" />
                        <TreeTableColumn fx:id="tbcStatus" prefWidth="75.0" text="%tbc.status" />
                        <TreeTableColumn fx:id="tbcActions" prefWidth="75.0" text="%tbc.actions" />
                            </columns>
                     <columnResizePolicy>
                        <TreeTableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                        </JFXTreeTableView>
                    </content>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
                </MFXScrollPane>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>
