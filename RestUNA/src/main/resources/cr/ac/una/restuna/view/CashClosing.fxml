<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXTreeTableView?>
<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXScrollPane?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TreeTableColumn?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="700.0" prefWidth="1000.0" stylesheets="@Styles.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.restuna.controller.CashClosingController">
   <children>
      <VBox layoutX="110.0" layoutY="78.0" prefHeight="200.0" prefWidth="100.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="200.0">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <Label text="%lb.cash.closing" />
               </children>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox prefHeight="200.0" prefWidth="119.0" spacing="10.0">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                     <children>
                        <MFXButton fx:id="btnCash" maxWidth="1.7976931348623157E308" onAction="#onActionBtnCash" prefHeight="80.0" text="%btn.cash" />
                        <MFXButton fx:id="btnCard" maxWidth="1.7976931348623157E308" onAction="#onActionBtnCard" prefHeight="80.0" text="%btn.card" />
                        <MFXButton fx:id="btnSinpe" maxWidth="1.7976931348623157E308" onAction="#onActionBtnSinpe" prefHeight="80.0" text="%btn.sinpe" />
                        <MFXButton fx:id="btnTip" contentDisplay="TOP" maxWidth="1.7976931348623157E308" onAction="#onActionBtnTip" prefHeight="80.0" text="%btn.tip">
                           <graphic>
                              <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" />
                           </graphic>
                        </MFXButton>
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="350.0" spacing="10.0">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                     <children>
                        <MFXTextField fx:id="txfInput" floatMode="DISABLED" maxWidth="1.7976931348623157E308" onAction="#onActionTxfInput" promptText="%txf.price.prompt" />
                        <VBox fx:id="keypadRoot" prefHeight="200.0" prefWidth="100.0" VBox.vgrow="ALWAYS" />
                        <HBox maxHeight="-Infinity" prefHeight="50.0" prefWidth="200.0">
                           <children>
                              <MFXButton fx:id="btnEnter" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#onActionBtnEnter" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                     <children>
                        <MFXScrollPane fx:id="tableRoot" hbarPolicy="NEVER" vbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                           <content>
                              <JFXTreeTableView fx:id="tbvPaymentBreakdown" prefHeight="518.0" prefWidth="483.0">
                                 <columns>
                                    <TreeTableColumn fx:id="tbcKey" prefWidth="285.0" resizable="false" text="%tbc.description" />
                                    <TreeTableColumn fx:id="tbcTotalAmount" minWidth="0.0" prefWidth="197.0" resizable="false" text="%tbc.total.amount" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TreeTableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </JFXTreeTableView>
                           </content>
                        </MFXScrollPane>
                        <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                           <children>
                              <MFXButton fx:id="btnOk" onAction="#onActionBtnOk" prefHeight="80.0" prefWidth="99.0" text="%btn.ok" />
                              <MFXButton fx:id="btnCancel" onAction="#onActionBtnCancel" prefHeight="80.0" prefWidth="99.0" text="%btn.cancel" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
