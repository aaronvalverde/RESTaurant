<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="500.0" spacing="10.0" styleClass="jfx-main-background" stylesheets="@Styles.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.restuna.controller.CashOpeningController">
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="200.0">
         <children>
            <Label styleClass="jfx-titles" text="%lb.cash.opening" />
         </children>
      </HBox>
      <VBox prefHeight="64.0" prefWidth="480.0" spacing="10.0">
         <children>
            <Label styleClass="jfx-labels" text="%lb.init.fund">
               <graphic>
                  <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../resources/icons/icons8-bolsa-de-dinero-50.png" />
                     </image></ImageView>
               </graphic></Label>
            <MFXTextField fx:id="txfInitialFund" floatMode="DISABLED" maxWidth="1.7976931348623157E308" promptText="%txf.price.prompt">
               <cursor>
                  <Cursor fx:constant="TEXT" />
               </cursor></MFXTextField>
         </children>
      </VBox>
      <VBox fx:id="keypadRoot" prefHeight="450.0" prefWidth="100.0" VBox.vgrow="ALWAYS" />
      <HBox minHeight="-Infinity" prefHeight="80.0" prefWidth="200.0" spacing="10.0">
         <children>
            <MFXButton fx:id="btnKeypad" contentDisplay="TOP" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#onActionBtnKeypad" prefWidth="160.0" rippleColor="#bdbdbd00" text="%btn.keypad" HBox.hgrow="ALWAYS">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
               <graphic>
                  <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
               </graphic></MFXButton>
            <MFXButton fx:id="btnOk" contentDisplay="TOP" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#onActionBtnOk" prefWidth="100.0" rippleColor="#bdbdbd00" text="%btn.ok">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
               <graphic>
                  <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
               </graphic></MFXButton>
            <MFXButton fx:id="btnCancel" contentDisplay="TOP" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#onActionBtnCancel" prefWidth="100.0" rippleColor="#bdbdbd00" text="%btn.cancel">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
               <graphic>
                  <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
               </graphic></MFXButton>
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
