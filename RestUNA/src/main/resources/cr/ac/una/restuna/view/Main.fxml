                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </MFXButton>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <BorderPane fx:id="contentArea" prefHeight="200.0" prefWidth="100.0" style="-fx-background-color: #faf4f0;" BorderPane.alignment="CENTER">
         <center>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
               <children>
                  <WebView fx:id="wvLogo" prefHeight="709.0" prefWidth="554.0" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </center></BorderPane>
    </center>
</BorderPane>
