<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.web.WebView?>

<BorderPane fx:id="mainLayout" prefHeight="800.0" prefWidth="1280.0" stylesheets="@Styles.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.restuna.controller.MainController">
    <top>
        <HBox fx:id="topbar" alignment="CENTER" prefHeight="120.0" prefWidth="1280.0" spacing="6.0" style="-fx-background-color: #5e3d26;" BorderPane.alignment="CENTER">
            <children>
                <MFXButton fx:id="btnSections" alignment="CENTER" contentDisplay="TOP" maxWidth="1.7976931348623157E308" onAction="#onActionBtnSections" text="%btn.sections" HBox.hgrow="ALWAYS">
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </MFXButton>
                <MFXButton fx:id="btnOrders" alignment="CENTER" contentDisplay="TOP" maxWidth="1.7976931348623157E308" onAction="#onActionBtnOrders" text="%btn.orders" HBox.hgrow="ALWAYS">
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </MFXButton>
                <MFXButton fx:id="btnBilling" alignment="CENTER" contentDisplay="TOP" maxWidth="1.7976931348623157E308" onAction="#onActionBtnBilling" text="%btn.billing" HBox.hgrow="ALWAYS">
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </MFXButton>
            <MFXButton fx:id="btnCashOpening" alignment="CENTER" contentDisplay="TOP" maxWidth="1.7976931348623157E308" onAction="#onActionBtnCashOpening" text="%btn.cash.opening" HBox.hgrow="ALWAYS">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
               <graphic>
                  <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
               </graphic>
            </MFXButton>
                <MFXButton fx:id="btnCashClosing" alignment="CENTER" contentDisplay="TOP" maxWidth="1.7976931348623157E308" onAction="#onActionBtnCashClosing" text="%btn.cash.closing" HBox.hgrow="ALWAYS">
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </MFXButton>
                <MFXButton fx:id="btnUsers" alignment="CENTER" contentDisplay="TOP" maxWidth="1.7976931348623157E308" onAction="#onActionBtnUsers" text="%btn.user.mgmt" HBox.hgrow="ALWAYS">
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </MFXButton>
                <MFXButton fx:id="btnSectionsMgmt" alignment="CENTER" contentDisplay="TOP" maxWidth="1.7976931348623157E308" onAction="#onActionBtnSectionsMgmt" text="%btn.sections.mgmt" HBox.hgrow="ALWAYS">
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </MFXButton>
                <MFXButton fx:id="btnMenuGroups" alignment="CENTER" contentDisplay="TOP" maxWidth="1.7976931348623157E308" onAction="#onActionBtnMenuGroups" text="%btn.menu.groups" HBox.hgrow="ALWAYS">
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
