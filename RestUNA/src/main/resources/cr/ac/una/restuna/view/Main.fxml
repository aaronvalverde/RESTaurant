<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane fx:id="mainLayout" prefHeight="800.0" prefWidth="1280.0" stylesheets="@Styles.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.restuna.controller.MainController">
    <top>
        <HBox fx:id="topbar" alignment="CENTER" prefHeight="120.0" prefWidth="1280.0" spacing="6.0" styleClass="jfx-main-background" BorderPane.alignment="CENTER">
            <children>
            <MFXButton fx:id="btnHome" alignment="CENTER" contentDisplay="TOP" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#onActionBtnHome" text="%btn.home" HBox.hgrow="ALWAYS">
               <graphic>
                  <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
               </graphic>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </MFXButton>
                <MFXButton fx:id="btnSections" alignment="CENTER" contentDisplay="TOP" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#onActionBtnSections" text="%btn.sections" HBox.hgrow="ALWAYS">
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </MFXButton>
                <MFXButton fx:id="btnBilling" alignment="CENTER" contentDisplay="TOP" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#onActionBtnBilling" text="%btn.billing" HBox.hgrow="ALWAYS">
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </MFXButton>
            <MFXButton fx:id="btnCashOpening" alignment="CENTER" contentDisplay="TOP" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#onActionBtnCashOpening" text="%btn.cash.opening" HBox.hgrow="ALWAYS">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
               <graphic>
                  <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
               </graphic>
            </MFXButton>
                <MFXButton fx:id="btnCashClosing" alignment="CENTER" contentDisplay="TOP" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#onActionBtnCashClosing" text="%btn.cash.closing" HBox.hgrow="ALWAYS">
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </MFXButton>
                <MFXButton fx:id="btnReports" alignment="CENTER" contentDisplay="TOP" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#onActionBtnReports" text="%btn.reports" HBox.hgrow="ALWAYS">
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </MFXButton>
                <MFXButton fx:id="btnLogout" alignment="CENTER" contentDisplay="TOP" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onAction="#onActionBtnSignOut" text="%btn.logout" HBox.hgrow="ALWAYS">
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </MFXButton>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <BorderPane fx:id="contentArea" prefHeight="200.0" prefWidth="100.0" style="-fx-background-color: #faf4f0;" BorderPane.alignment="CENTER">
         <center>
            <HBox alignment="BOTTOM_RIGHT" prefHeight="100.0" prefWidth="200.0" spacing="10.0" styleClass="jfx-main-background-image" BorderPane.alignment="CENTER">
               <children>
                  <HBox alignment="BOTTOM_RIGHT" prefHeight="660.0" prefWidth="210.0" spacing="10.0">
                     <children>
                        <MFXButton fx:id="btnManagement" alignment="CENTER" contentDisplay="TOP" maxWidth="1.7976931348623157E308" minHeight="80.0" onAction="#onActionBtnManagement" prefWidth="100.0" text="%btn.management" HBox.hgrow="ALWAYS">
                           <graphic>
                              <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                           </graphic>
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                        </MFXButton>
                        <MFXButton fx:id="btnSettings" alignment="CENTER" contentDisplay="TOP" maxWidth="1.7976931348623157E308" minHeight="80.0" onAction="#onActionBtnSettings" prefWidth="100.0" text="%btn.settings" HBox.hgrow="ALWAYS">
                           <graphic>
                              <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                           </graphic>
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                        </MFXButton>
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
         </center></BorderPane>
    </center>
</BorderPane>
