                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </MFXButton>
                <MFXButton fx:id="btnMenuItems" alignment="CENTER" contentDisplay="TOP" maxWidth="1.7976931348623157E308" onAction="#onActionBtnMenuItems" text="%btn.menu.items" HBox.hgrow="ALWAYS">
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </MFXButton>
                <MFXButton fx:id="btnReports" alignment="CENTER" contentDisplay="TOP" maxWidth="1.7976931348623157E308" onAction="#onActionBtnReports" text="%btn.reports" HBox.hgrow="ALWAYS">
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </MFXButton>
                <MFXButton fx:id="btnSettings" alignment="CENTER" contentDisplay="TOP" maxWidth="1.7976931348623157E308" onAction="#onActionBtnSettings" text="%btn.settings" HBox.hgrow="ALWAYS">
                    <graphic>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
