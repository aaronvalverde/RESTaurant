rop></IndexProp><Tablespace/><Unusable>0</Unusable><Indexing>FULL</Indexing><DeferredInvalidation>0</DeferredInvalidation><AutoIndex>0</AutoIndex></PERIndexOR19></Indexes><CheckConstraints><PERCheckConstraintEntityOR19 ObjectType="2029" CSAOName="PERCheckConstraintEntityOR19" CSAOCaption="Check Constraint Entity"><Id>{D45ABF90-53DF-4ADE-948C-B8A1B0F72EB7}</Id><Name>CHK_ORDEN_ESTADO</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><GalleryItemID>{00000000-0000-0000-0000-000000000000}</GalleryItemID><GalleryID>{00000000-0000-0000-0000-000000000000}</GalleryID><GalleryObjectID>{00000000-0000-0000-0000-000000000000}</GalleryObjectID><RNOffset>0</RNOffset><RNLength>0</RNLength><IgnoreNC>0</IgnoreNC><VerifyState>0</VerifyState><GenerateCode>1</GenerateCode><Notes></Notes><Comments></Comments><SQL>ESTADO IN ('ABIERTA','FACTURADA','CANCELADA')</SQL><Caption>CHK_ORDEN_ESTADO</Caption><Rule/><Deferrable>0</Deferrable><Deferred>0</Deferred><Disable>0</Disable><NoValidate>0</NoValidate><Rely>0</Rely></PERCheckConstraintEntityOR19><PERCheckConstraintEntityOR19 ObjectType="2029" CSAOName="PERCheckConstraintEntityOR19" CSAOCaption="Check Constraint Entity"><Id>{594C4DDA-FAB2-4DDE-818D-CB030A05BA78}</Id><Name>CHK_ORDEN_SUBTOTAL</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><GalleryItemID>{00000000-0000-0000-0000-000000000000}</GalleryItemID><GalleryID>{00000000-0000-0000-0000-000000000000}</GalleryID><GalleryObjectID>{00000000-0000-0000-0000-000000000000}</GalleryObjectID><RNOffset>0</RNOffset><RNLength>0</RNLength><IgnoreNC>0</IgnoreNC><VerifyState>0</VerifyState><GenerateCode>1</GenerateCode><Notes></Notes><Comments></Comments><SQL>SUBTOTAL &gt;= 0</SQL><Caption>CHK_ORDEN_SUBTOTAL</Caption><Rule/><Deferrable>0</Deferrable><Deferred>0</Deferred><Disable>0</Disable><NoValidate>0</NoValidate><Rely>0</Rely></PERCheckConstraintEntityOR19></CheckConstraints><Category/><Triggers><PERTriggerEntityOR19 ObjectType="2016" CSAOName="PERTriggerEntityOR19" CSAOCaption="Entity Trigger"><Id>{312C297A-F901-4365-8959-446E34FFF0DD}</Id><Name>TS_ORDEN_SEQ_ORDEN</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><GalleryItemID>{00000000-0000-0000-0000-000000000000}</GalleryItemID><GalleryID>{00000000-0000-0000-0000-000000000000}</GalleryID><GalleryObjectID>{00000000-0000-0000-0000-000000000000}</GalleryObjectID><RNOffset>0</RNOffset><RNLength>0</RNLength><IgnoreNC>0</IgnoreNC><VerifyState>0</VerifyState><GenerateCode>1</GenerateCode><Notes></Notes><Comments></Comments><SQL><![CDATA[BEGIN
  IF :NEW.ID_ORDEN IS NULL OR :NEW.ID_ORDEN <= 0 THEN
    :NEW.ID_ORDEN := SEQ_ORDEN.NEXTVAL;
  END IF;
  -- Generar nÃºmero de orden automÃ¡tico
  IF :NEW.NUMERO_ORDEN IS NULL THEN
    :NEW.NUMERO_ORDEN := 'ORD-' || TO_CHAR(SYSDATE, 'YYYYMMDD') || '-' || LPAD(:NEW.ID_ORDEN, 6, '0');
  END IF;
END;]]></SQL><Caption>TS_ORDEN_SEQ_ORDEN</Caption><GenerateSQLOnly>0</GenerateSQLOnly><DbOwner><Id>{80426A6A-4A84-40DB-8F93-D4931FFEC881}</Id></DbOwner><EachRow>1</EachRow><EventDelete>0</EventDelete><EventInsert>1</EventInsert><EventUpdate>0</EventUpdate><EventUpdateColumns></EventUpdateColumns><Fire>BEFORE</Fire><Referencing_new></Referencing_new><Referencing_old></Referencing_old><WhenCondition></WhenCondition><Follows></Follows><IsEnable>1</IsEnable><CrosseditionTriggerType></CrosseditionTriggerType><Edition/><IsCrosseditionTrigger>0</IsCrosseditionTrigger><TriggerOrderingType>FOLLOWS</TriggerOrderingType><Noneditionable>0</Noneditionable></PERTriggerEntityOR19><PERTriggerEntityOR19 ObjectType="2016" CSAOName="PERTriggerEntityOR19" CSAOCaption="Entity Trigger"><Id>{F0151328-76B6-40B6-A549-F068BC4E3070}</Id><Name>TSU_ORDEN_SEQ_ORDEN</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><GalleryItemID>{00000000-0000-0000-0000-000000000000}</GalleryItemID><GalleryID>{00000000-0000-0000-0000-000000000000}</GalleryID><GalleryObjectID>{00000000-0000-0000-0000-000000000000}</GalleryObjectID><RNOffset>0</RNOffset><RNLength>0</RNLength><IgnoreNC>0</IgnoreNC><VerifyState>0</VerifyState><GenerateCode>1</GenerateCode><Notes></Notes><Comments></Comments><SQL><![CDATA[BEGIN
  RAISE_APPLICATION_ERROR(-20007,'No se puede modificar ID_ORDEN (secuencia).');
END;]]></SQL><Caption>TSU_ORDEN_SEQ_ORDEN</Caption><GenerateSQLOnly>0</GenerateSQLOnly><DbOwner><Id>{80426A6A-4A84-40DB-8F93-D4931FFEC881}</Id></DbOwner><EachRow>1</EachRow><EventDelete>0</EventDelete><EventInsert>0</EventInsert><EventUpdate>1</EventUpdate><EventUpdateColumns>ID_ORDEN</EventUpdateColumns><Fire>AFTER</Fire><Referencing_new></Referencing_new><Referencing_old></Referencing_old><WhenCondition></WhenCondition><Follows></Follows><IsEnable>1</IsEnable><CrosseditionTriggerType></CrosseditionTriggerType><Edition/><IsCrosseditionTrigger>0</IsCrosseditionTrigger><TriggerOrderingType>FOLLOWS</TriggerOrderingType><Noneditionable>0</Noneditionable></PERTriggerEntityOR19><PERTriggerEntityOR19 ObjectType="2016" CSAOName="PERTriggerEntityOR19" CSAOCaption="Entity Trigger"><Id>{BC21F0D0-0154-4936-AADF-C24A0BA6F6B3}</Id><Name>TR_ORDEN_ESTADO_MESA</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><GalleryItemID>{00000000-0000-0000-0000-000000000000}</GalleryItemID><GalleryID>{00000000-0000-0000-0000-000000000000}</GalleryID><GalleryObjectID>{00000000-0000-0000-0000-000000000000}</GalleryObjectID><RNOffset>0</RNOffset><RNLength>0</RNLength><IgnoreNC>0</IgnoreNC><VerifyState>0</VerifyState><GenerateCode>1</GenerateCode><Notes></Notes><Comments></Comments><SQL><![CDATA[BEGIN
  -- Actualizar estado de mesa al insertar orden
  IF INSERTING AND :NEW.ID_MESA IS NOT NULL THEN
    UPDATE MESA SET ESTADO = 'OCUPADA' 
    WHERE ID_MESA = :NEW.ID_MESA AND ESTADO = 'LIBRE';
  END IF;
  
  -- Actualizar estado de mesa al cambiar estado de orden
  IF UPDATING AND :NEW.ESTADO = 'FACTURADA' AND :NEW.ID_MESA IS NOT NULL THEN
    UPDATE MESA SET ESTADO = 'LIBRE' 
    WHERE ID_MESA = :NEW.ID_MESA;
  END IF;
  
  -- Liberar mesa al eliminar orden
  IF DELETING AND :OLD.ID_MESA IS NOT NULL THEN
    UPDATE MESA SET ESTADO = 'LIBRE' 
    WHERE ID_MESA = :OLD.ID_MESA;
  END IF;
