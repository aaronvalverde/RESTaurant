  IF :NEW.ID_DETALLE_FACTURA IS NULL OR :NEW.ID_DETALLE_FACTURA <= 0 THEN
    :NEW.ID_DETALLE_FACTURA := SEQ_DETALLE_FACTURA.NEXTVAL;
  END IF;
