  -- Actualizar contador del producto
  UPDATE PRODUCTO 
  SET CANTIDAD_VENDIDA = CANTIDAD_VENDIDA + :NEW.CANTIDAD
  WHERE ID_PRODUCTO = :NEW.ID_PRODUCTO;
  
  -- Actualizar contador del grupo
  UPDATE GRUPO_PRODUCTO 
  SET CANTIDAD_VENDIDA = CANTIDAD_VENDIDA + :NEW.CANTIDAD
  WHERE ID_GRUPO_PRODUCTO = (
    SELECT ID_GRUPO_PRODUCTO FROM PRODUCTO WHERE ID_PRODUCTO = :NEW.ID_PRODUCTO
  );
END;]]></SQL><Caption>TR_DETALLEFACTURA_CONTADOR_VENTAS</Caption><GenerateSQLOnly>0</GenerateSQLOnly><DbOwner><Id>{80426A6A-4A84-40DB-8F93-D4931FFEC881}</Id></DbOwner><EachRow>1</EachRow><EventDelete>0</EventDelete><EventInsert>1</EventInsert><EventUpdate>0</EventUpdate><EventUpdateColumns></EventUpdateColumns><Fire>AFTER</Fire><Referencing_new></Referencing_new><Referencing_old></Referencing_old><WhenCondition></WhenCondition><Follows></Follows><IsEnable>1</IsEnable><CrosseditionTriggerType></CrosseditionTriggerType><Edition/><IsCrosseditionTrigger>0</IsCrosseditionTrigger><TriggerOrderingType>FOLLOWS</TriggerOrderingType><Noneditionable>0</Noneditionable></PERTriggerEntityOR19></Triggers><DbOwner><Id>{80426A6A-4A84-40DB-8F93-D4931FFEC881}</Id></DbOwner><Schema/><AccessDriverType>ORACLE_LOADER</AccessDriverType><AccessParameters></AccessParameters><Directory/><GlobalTemp>0</GlobalTemp><IsExternalTable>0</IsExternalTable><IsUsingClob>0</IsUsingClob><LocationSpecifierList></LocationSpecifierList><PhysicalProp></PhysicalProp><RejectLimit></RejectLimit><TableProp></TableProp><Tablespace/><TempPreserve>0</TempPreserve><SegmentCreation></SegmentCreation><InnerScript></InnerScript><Collate></Collate><MemoptimizeForRead>0</MemoptimizeForRead><PrivateTemp>0</PrivateTemp><IsHybridPartitionedTable>0</IsHybridPartitionedTable><MemoptimizeForWrite>0</MemoptimizeForWrite></PEREntityOR19><PEREntityOR19 ObjectType="2002" CSAOName="PEREntityOR19" CSAOCaption="Entity"><Id>{94CAC6F6-DBF3-48CC-B379-B12731578D96}</Id><Name>CIERRE_CAJA</Name><Ordinal>0</Ordinal><GlobalOrder>0</GlobalOrder><GalleryItemID>{00000000-0000-0000-0000-000000000000}</GalleryItemID><GalleryID>{00000000-0000-0000-0000-000000000000}</GalleryID><GalleryObjectID>{00000000-0000-0000-0000-000000000000}</GalleryObjectID><RNOffset>0</RNOffset><RNLength>0</RNLength><IgnoreNC>0</IgnoreNC><VerifyState>0</VerifyState><GenerateCode>1</GenerateCode><BeforeScript></BeforeScript><AfterScript></AfterScript><Notes></Notes><Commen